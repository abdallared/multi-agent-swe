class TokenManager:
    """Dynamically calculates optimal token budget per agent"""
    
    # Base budgets per agent type
    BASE_BUDGETS = {
        "planner": 2000,
        "architect": 4000,
        "backend": 6000,
        "frontend": 8000,
        "testing": 3000,
        "docker": 2000,
    }
    
    # Complexity multipliers
    MULTIPLIERS = {
        "simple": 1.0,
        "medium": 1.5,
        "complex": 2.0,
    }
    
    def get_budget(self, agent_type: str, complexity: str = "medium") -> int:
        base = self.BASE_BUDGETS.get(agent_type, 4000)
        multiplier = self.MULTIPLIERS.get(complexity, 1.0)
        return int(base * multiplier)
    
    def get_temperature(self, agent_type: str) -> float:
        """Agent-specific temperature defaults"""
        temps = {
            "planner": 0.7,    # creative
            "architect": 0.1,  # deterministic
            "backend": 0.1,    # precise code
            "frontend": 0.2,   # slightly creative for UI
            "testing": 0.1,    # precise tests
        }
        return temps.get(agent_type, 0.3)
```


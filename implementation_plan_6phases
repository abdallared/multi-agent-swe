class FixLoop:
    """Orchestrates the review → fix cycle"""
    
    MAX_ITERATIONS = 2
    
    async def run(self, agent, context, generated_code):
        for i in range(self.MAX_ITERATIONS):
            review = await reviewer.execute({...code, ...context})
            
            if review["status"] == "pass":
                return generated_code  # ✅ Code is good
            
            # Re-generate with fix instructions
            fix_prompt = self._build_fix_prompt(generated_code, review["issues"])
            generated_code = await agent.execute({...context, "fix_instructions": fix_prompt})
        
        return generated_code  # Return best effort after max iterations
```

